{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "default": {},
      "type": "object",
      "properties": {
        "defaultLocale": {
          "default": "es",
          "type": "string",
          "enum": [
            "es",
            "en"
          ]
        },
        "paper": {
          "default": "letter",
          "description": "Tamaño de página al imprimir",
          "type": "string",
          "enum": [
            "letter",
            "A4"
          ]
        },
        "accentColor": {
          "default": "#5754fc",
          "type": "string"
        },
        "monogram": {
          "description": "Iniciales grandes del diseño moderno, ej. \"JC\"",
          "type": "string"
        },
        "modern": {
          "default": {},
          "type": "object",
          "properties": {
            "sidebar": {
              "default": [
                "summary",
                "skills",
                "languages",
                "contact"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "summary",
                  "work",
                  "education",
                  "skills",
                  "languages",
                  "contact"
                ]
              }
            },
            "main": {
              "default": [
                "work",
                "education"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "summary",
                  "work",
                  "education",
                  "skills",
                  "languages",
                  "contact"
                ]
              }
            },
            "showWorkSkills": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "harvard": {
          "default": {},
          "type": "object",
          "properties": {
            "sections": {
              "default": [
                "summary",
                "work",
                "education",
                "skills",
                "languages"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "summary",
                  "work",
                  "education",
                  "skills",
                  "languages",
                  "contact"
                ]
              }
            },
            "maxHighlights": {
              "description": "Máximo de logros por trabajo",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "es": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "es",
                "en"
              ]
            }
          ],
          "description": "Título profesional"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string"
        },
        "whatsapp": {
          "description": "Número sin \"+\" ni espacios, ej. 573001234567",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "es": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "es",
                "en"
              ]
            }
          ]
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "es": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "es",
                "en"
              ]
            }
          ]
        },
        "profiles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "network",
              "url"
            ]
          }
        }
      },
      "required": [
        "name",
        "label"
      ]
    },
    "work": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "endDate": {
            "description": "Vacío = actualidad",
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "highlights": {
            "default": [],
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "en": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "skills": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "company",
          "position",
          "startDate"
        ]
      }
    },
    "education": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "highlights": {
            "default": [],
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "en": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "institution",
          "area"
        ]
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "keywords": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "en": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          }
        },
        "required": [
          "name",
          "keywords"
        ]
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          },
          "fluency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "es": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "es",
                  "en"
                ]
              }
            ]
          }
        },
        "required": [
          "language",
          "fluency"
        ]
      }
    }
  },
  "required": [
    "basics"
  ]
}
