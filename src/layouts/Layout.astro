---
import '@/styles/global.css'
import { LOCALES, OG_LOCALES, localePath, type ResolvedCv } from '@/lib/cv'

interface Props {
  cv: ResolvedCv
  template: 'modern' | 'harvard'
}

const { cv, template } = Astro.props
const { locale, labels, settings, basics, seo } = cv
const otherLocale = LOCALES.find((l) => l !== locale) ?? locale
const page = template === 'harvard' ? 'harvard' : ''
const title = `${basics.name} – ${basics.label}${template === 'harvard' ? ' (Harvard)' : ''}`
const pageSize = settings.paper === 'A4' ? 'A4' : 'letter'

const abs = (path: string) => new URL(path, Astro.site).href
const canonical = abs(localePath(locale, page))
const ogImage = abs(locale === settings.defaultLocale ? '/og.png' : `/og-${locale}.png`)

// Structured data so search engines understand this is a person's CV
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: basics.name,
  jobTitle: basics.label,
  description: seo.description,
  email: basics.email && `mailto:${basics.email}`,
  url: canonical,
  image: ogImage,
  address: basics.location && { '@type': 'PostalAddress', addressLocality: basics.location },
  sameAs: basics.profiles.map((p) => p.url),
  knowsLanguage: cv.languages.map((l) => l.language)
}
---

<!doctype html>
<html lang={locale} style={`--accent: ${settings.accentColor}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={basics.name} />
    <meta name="theme-color" content={settings.accentColor} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l, page))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(settings.defaultLocale, page))} />
    <link rel="alternate" type="text/markdown" href={localePath(locale, 'cv.md')} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook, Slack, Telegram…) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={basics.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${basics.name} – ${basics.label}`} />
    <meta property="profile:first_name" content={basics.name.split(' ')[0]} />
    <meta property="profile:last_name" content={basics.name.split(' ').slice(1).join(' ')} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style set:html={`@page { size: ${pageSize}; }`}></style>
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body class={`template-${template}`} data-paper={pageSize}>
    <nav class="toolbar no-print" aria-label="CV">
      <a href={localePath(locale)} aria-current={template === 'modern' ? 'page' : undefined}>{labels.modern}</a>
      <a href={localePath(locale, 'harvard')} aria-current={template === 'harvard' ? 'page' : undefined}>{labels.harvard}</a>
      <a href={localePath(locale, 'cv.md')}>{labels.markdown}</a>
      <a href={localePath(otherLocale, page)} hreflang={otherLocale}>{labels.otherLanguage}</a>
      <button type="button" id="print-btn">{labels.print}</button>
    </nav>
    <slot />
    <script>
      document.getElementById('print-btn')?.addEventListener('click', () => window.print())
    </script>
  </body>
</html>
